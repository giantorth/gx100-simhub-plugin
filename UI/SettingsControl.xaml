<UserControl x:Class="GX100Plugin.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:profilescommon="clr-namespace:SimHub.Plugins.ProfilesCommon;assembly=SimHub.Plugins"
             Padding="10">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="ConnectionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PanelBox" TargetType="Border">
            <Setter Property="Background" Value="#18000000"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StatusBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <!-- Shared by the gear readout row and the gap between the sequential
             tiles, so Shift -/+ line up with the gate's top and bottom rows. -->
        <GridLength x:Key="NeutralRowHeight">60</GridLength>
        <Style x:Key="PanelDivider" TargetType="Separator">
            <Setter Property="Margin" Value="0,10,0,6"/>
            <Setter Property="Opacity" Value="0.3"/>
        </Style>
        <Style x:Key="FooterLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FooterValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="FooterSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- Status on the left, profile and settings on the right -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatusBox}" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Connection + sequential mode -->
                        <DockPanel LastChildFill="False">
                            <Ellipse x:Name="ConnectionDot" DockPanel.Dock="Left"
                                     Style="{StaticResource ConnectionDot}" Fill="Gray"/>
                            <TextBlock x:Name="ConnectionStatus" DockPanel.Dock="Left" Text="Disconnected"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <CheckBox x:Name="ConnectionToggle" DockPanel.Dock="Left" Content="Enable"
                                      IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"
                                      Checked="ConnectionToggle_Changed" Unchecked="ConnectionToggle_Changed"/>
                            <!-- Label before the box; clicking the label toggles it too -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sequential" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Cursor="Hand" MouseLeftButtonUp="SeqModeLabel_Click"/>
                                <CheckBox x:Name="SeqModeToggle" VerticalAlignment="Center"
                                          Checked="SeqModeToggle_Changed" Unchecked="SeqModeToggle_Changed"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <!-- H-pattern gate: 1/3/5 over 2/4/6, gear readout in the neutral row -->
                            <Border x:Name="HPanel" Style="{StaticResource PanelBox}">
                                <StackPanel>
                                    <TextBlock Text="H-Pattern" Style="{StaticResource PanelTitle}"/>
                                    <Grid x:Name="HGateGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="{StaticResource NeutralRowHeight}"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="GearDisplay" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="N" FontSize="36" FontWeight="Bold" FontFamily="Consolas"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Separator Style="{StaticResource PanelDivider}"/>
                                    <DockPanel>
                                        <TextBlock x:Name="HSensValue" DockPanel.Dock="Right" Style="{StaticResource FooterValue}"/>
                                        <TextBlock Text="Sensitivity" Style="{StaticResource FooterLabel}"/>
                                    </DockPanel>
                                    <Slider x:Name="HSensSlider" Style="{StaticResource FooterSlider}"
                                            ValueChanged="HSensSlider_Changed"/>
                                    <Button x:Name="HCalButton" Content="Calibrate" Click="HCalButton_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Sequential: push (Shift -) above, pull (Shift +) below -->
                            <Border x:Name="SeqPanel" Style="{StaticResource PanelBox}">
                                <StackPanel>
                                    <TextBlock Text="Sequential" Style="{StaticResource PanelTitle}"/>
                                    <Grid x:Name="SeqGrid">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="{StaticResource NeutralRowHeight}"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>

                                    <Separator Style="{StaticResource PanelDivider}"/>
                                    <DockPanel>
                                        <TextBlock x:Name="SeqSensValue" DockPanel.Dock="Right" Style="{StaticResource FooterValue}"/>
                                        <TextBlock Text="Sensitivity" Style="{StaticResource FooterLabel}"/>
                                    </DockPanel>
                                    <Slider x:Name="SeqSensSlider" Style="{StaticResource FooterSlider}"
                                            ValueChanged="SeqSensSlider_Changed"/>
                                    <Button x:Name="SeqCalButton" Content="Calibrate" Click="SeqCalButton_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Extra buttons -->
                            <Border Style="{StaticResource PanelBox}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Buttons" Style="{StaticResource PanelTitle}"/>
                                    <StackPanel x:Name="ButtonsPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <CheckBox x:Name="ShowSensorsToggle" Content="Show sensor readings" Margin="0,12,0,0"
                                  Checked="ShowSensorsToggle_Changed" Unchecked="ShowSensorsToggle_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Right column: profile, then the settings it holds -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <profilescommon:ProfileList x:Name="ProfileListControl"/>

                    <!-- Configuration -->
                    <TextBlock Text="Configuration" Style="{StaticResource SectionHeader}"/>
                    <CheckBox x:Name="ModeChimeToggle" Content="Chime when sequential mode changes" Margin="0,4"
                              Checked="ModeChimeToggle_Changed" Unchecked="ModeChimeToggle_Changed"/>
                    <CheckBox x:Name="Combo1Toggle" Content="Select extra gears with pull ring" Margin="0,4"
                              Checked="Combo1Toggle_Changed" Unchecked="Combo1Toggle_Changed"/>
                    <CheckBox x:Name="Combo2Toggle" Content="Select extra gears with expansion buttons" Margin="0,4"
                              Checked="Combo2Toggle_Changed" Unchecked="Combo2Toggle_Changed"/>
                    <CheckBox x:Name="PullBtnToggle" Content="Pull Ring Button Visible" Margin="0,4"
                              Checked="PullBtnToggle_Changed" Unchecked="PullBtnToggle_Changed"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
