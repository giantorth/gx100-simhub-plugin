<UserControl x:Class="GX100Plugin.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:profilescommon="clr-namespace:SimHub.Plugins.ProfilesCommon;assembly=SimHub.Plugins"
             Padding="10">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="180"/>
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="SettingSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>
        <Style x:Key="ConnectionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- Connection -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="ConnectionToggle" Content="Enable Connection" IsChecked="True"
                          Checked="ConnectionToggle_Changed" Unchecked="ConnectionToggle_Changed"/>
                <Ellipse x:Name="ConnectionDot" Style="{StaticResource ConnectionDot}" Fill="Gray" Margin="20,0,8,0"/>
                <TextBlock x:Name="ConnectionStatus" Text="Disconnected" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Profile Selector -->
            <TextBlock Text="Profiles" Style="{StaticResource SectionHeader}"/>
            <profilescommon:ProfileList x:Name="ProfileListControl" Margin="0,0,0,10"/>

            <!-- Configuration -->
            <TextBlock Text="Configuration" Style="{StaticResource SectionHeader}"/>

            <!-- Sequential Mode Toggle -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Sequential Mode" Style="{StaticResource SliderLabel}"/>
                <CheckBox x:Name="SeqModeToggle" Checked="SeqModeToggle_Changed" Unchecked="SeqModeToggle_Changed"/>
            </StackPanel>

            <!-- H-Pattern Sensitivity -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="H-Pattern Sensitivity" Style="{StaticResource SliderLabel}"/>
                <Slider x:Name="HSensSlider" Style="{StaticResource SettingSlider}"
                        Minimum="0" Maximum="255" TickFrequency="1"
                        ValueChanged="HSensSlider_Changed"/>
                <TextBlock x:Name="HSensValue" Style="{StaticResource SliderValue}"/>
            </StackPanel>

            <!-- Sequential Sensitivity -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Sequential Sensitivity" Style="{StaticResource SliderLabel}"/>
                <Slider x:Name="SeqSensSlider" Style="{StaticResource SettingSlider}"
                        Minimum="0" Maximum="255" TickFrequency="1"
                        ValueChanged="SeqSensSlider_Changed"/>
                <TextBlock x:Name="SeqSensValue" Style="{StaticResource SliderValue}"/>
            </StackPanel>

            <!-- Switches -->
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Combination Switch 1" Style="{StaticResource SliderLabel}"/>
                <CheckBox x:Name="Combo1Toggle" Checked="Combo1Toggle_Changed" Unchecked="Combo1Toggle_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Combination Switch 2" Style="{StaticResource SliderLabel}"/>
                <CheckBox x:Name="Combo2Toggle" Checked="Combo2Toggle_Changed" Unchecked="Combo2Toggle_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Pull Button" Style="{StaticResource SliderLabel}"/>
                <CheckBox x:Name="PullBtnToggle" Checked="PullBtnToggle_Changed" Unchecked="PullBtnToggle_Changed"/>
            </StackPanel>

            <!-- Apply Button -->
            <Button x:Name="ApplyButton" Content="Apply Settings" Width="150" HorizontalAlignment="Left"
                    Margin="0,10,0,0" Click="ApplyButton_Click"/>

            <!-- Calibration -->
            <TextBlock Text="Calibration" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <Button x:Name="HCalButton" Content="Start H-Pattern Calibration" Width="220"
                        Click="HCalButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="SeqCalButton" Content="Start Sequential Calibration" Width="220"
                        Click="SeqCalButton_Click"/>
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="Status" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Current Gear" Style="{StaticResource SliderLabel}"/>
                <TextBlock x:Name="GearDisplay" Text="N" FontSize="32" FontWeight="Bold"
                           FontFamily="Consolas" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Sequential" Style="{StaticResource SliderLabel}"/>
                <TextBlock x:Name="SeqUpIndicator" Text="UP" Margin="0,0,10,0" Foreground="Gray"/>
                <TextBlock x:Name="SeqDownIndicator" Text="DOWN" Foreground="Gray"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Extra Buttons" Style="{StaticResource SliderLabel}"/>
                <TextBlock x:Name="Btn1Indicator" Text="B1" Margin="0,0,6,0" Foreground="Gray"/>
                <TextBlock x:Name="Btn2Indicator" Text="B2" Margin="0,0,6,0" Foreground="Gray"/>
                <TextBlock x:Name="Btn3Indicator" Text="B3" Margin="0,0,6,0" Foreground="Gray"/>
                <TextBlock x:Name="Btn4Indicator" Text="B4" Margin="0,0,6,0" Foreground="Gray"/>
                <TextBlock x:Name="Btn5Indicator" Text="B5" Foreground="Gray"/>
            </StackPanel>

            <!-- Options -->
            <TextBlock Text="Options" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Auto-apply profile on launch" Style="{StaticResource SliderLabel}"/>
                <CheckBox x:Name="AutoApplyToggle" Checked="AutoApplyToggle_Changed" Unchecked="AutoApplyToggle_Changed"/>
            </StackPanel>
            <Button Content="Clear All Settings" Width="150" HorizontalAlignment="Left"
                    Margin="0,10,0,0" Click="ClearSettings_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
